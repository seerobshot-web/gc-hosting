# Set unique database credentials; never reuse GCH billing credentials.
CI_ENVIRONMENT = development
# NOTE for tests/http-startup.sh: that script overrides app.baseURL and
# glinks.enableTenantRoutes per-process via shell env vars (app_baseURL=...,
# glinks_enableTenantRoutes=...) for its own ephemeral test server. A dotted
# value set here always wins over that underscore-form override (BaseConfig
# checks the dotted .env form first, regardless of which process set which),
# so a .env copied from this file makes both http-startup.sh modes fail in a
# confusing way (see docs/glinks/verification.md, "Verified full pass on
# 2026-09-21"). If you're running that script locally, comment out both
# lines below first; restore them for ordinary browsing afterward.
app.baseURL = 'http://localhost:8088/'
database.default.hostname = db
database.default.port = 5432
database.default.database = glinks
database.default.username = glinks
database.default.password = replace-me
database.default.DBDriver = Postgre

# Disposable native PostgreSQL test database only.
database.tests.hostname = 127.0.0.1
database.tests.port = 5432
database.tests.database = glinks_test
database.tests.username = glinks
database.tests.password = replace-test-password
database.tests.DBDriver = Postgre

# Development routes enabled after native Actions gates passed. Production remains opt-in.
glinks.enableTenantRoutes = true

# Use the optional local Mailpit profile during development.
email.protocol = smtp
email.SMTPHost = mail
email.SMTPPort = 1025
email.SMTPCrypto = ''
email.fromEmail = 'glinks@example.test'
email.fromName = GLINKS
