{
  "name": "@gch/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm --filter @gch/database run generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "pnpm --filter @gch/database run generate && node --import tsx --test src/**/*.spec.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gch/database": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-fastify": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/config": "^3.3.0",
    "@nestjs/schedule": "^4.1.1",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
