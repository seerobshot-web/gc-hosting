{
  "name": "@gch/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm --filter @gch/commerce run build && pnpm --filter @gch/database run build && pnpm --filter @gch/permissions run build && tsc -p tsconfig.json",
    "deploy-copy": "node scripts/deploy-copy.js",
    "start": "node dist/main.js",
    "test": "pnpm --filter @gch/database run generate && node scripts/test.mjs",
    "test:commerce:mysql": "node --import tsx --test test/commerce.mysql.integration.ts",
    "typecheck:commerce:mysql": "tsc -p test/tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@gch/database": "workspace:*",
    "@gch/permissions": "workspace:*",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5",
    "@gch/commerce": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
