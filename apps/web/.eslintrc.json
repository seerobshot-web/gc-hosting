{
  "root": true,
  "extends": ["eslint:recommended", "plugin:astro/recommended"],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist", ".astro"],
  "overrides": [
    {
      "files": ["*.astro"],
      "parser": "astro-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser",
        "extraFileExtensions": [".astro"]
      }
    },
    {
      "files": ["*.ts"],
      "parser": "@typescript-eslint/parser"
    }
  ]
}
