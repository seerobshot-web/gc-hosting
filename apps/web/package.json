{
  "name": "@gch/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "pnpm --filter @gch/commerce run build && astro build",
    "start": "astro preview --port 3000",
    "lint": "eslint src --ext .astro,.ts,.tsx",
    "test": "node --import tsx --test src/content/tools/*.spec.ts",
    "typecheck": "astro check",
    "validate:routes": "node scripts/validate-public-routes.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.2",
    "@gch/motion": "workspace:*",
    "@gch/ui": "workspace:*",
    "astro": "^7.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "@gch/commerce": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/tailwind": "^6.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@typescript-eslint/parser": "^8.71.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
