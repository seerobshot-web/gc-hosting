---
import GCHHudLabel from "./GCHHudLabel.astro";
import { planTierNames, contentSources } from "../../content/marketing-content";

const rows = [
  "Core website / builder access",
  "Hosting foundation",
  "Growth / visibility layer",
  "Advanced managed support",
];
const catalogSource = contentSources.canonicalCatalog;
---
<section class="plans" id="plan-matrix" aria-labelledby="plans-title">
  <header>
    <GCHHudLabel index="28" label="Plans / tier comparison" />
    <h2 id="plans-title">Compare verified capabilities before price.</h2>
    <p>
      The established tier names are shown here because they are referenced by the repository's
      Website Builder delivery blueprint. Feature inclusion, limits, billing periods, and pricing
      are intentionally withheld until the canonical catalog supplies them.
    </p>
  </header>

  <div class="plans__wrap" role="region" aria-label="Tier capability verification matrix" tabindex="0">
    <table>
      <caption class="sr-only">Verification matrix for SEED, FRUIT, HARVEST, and LABORER tiers</caption>
      <thead>
        <tr>
          <th scope="col">Capability</th>
          {planTierNames.map((name) => (
            <th scope="col">
              <span>{name}</span>
              <small>Tier name verified</small>
              <b>Catalog required</b>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">{row}</th>
            {planTierNames.map(() => (
              <td><span class="pending">To verify</span></td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="plans__note">
    Source contract: <strong>{catalogSource.label}</strong>. No plan entitlement becomes public
    until it is present in the authoritative product registry or approved catalog feed.
  </p>
</section>
<style>
.plans{padding-block:clamp(4rem,8vw,7rem)}.plans header{max-width:54rem}.plans h2{max-width:14ch;margin:.8rem 0 1rem;font:800 clamp(2rem,4.6vw,4.3rem)/.98 "Outfit",system-ui,sans-serif;letter-spacing:-.05em}.plans header p,.plans__note{color:var(--gch-text-secondary);font:400 1rem/1.6 "Outfit",sans-serif}.plans__wrap{overflow:auto;margin-top:2rem;border:1px solid var(--gch-border-light);border-radius:1rem;background:var(--gch-white)}.plans__wrap:focus-visible{outline:2px solid var(--gch-blue);outline-offset:4px}table{width:100%;min-width:760px;border-collapse:collapse}th,td{padding:1rem;border-bottom:1px solid var(--gch-border-light);border-right:1px solid var(--gch-border-light);text-align:left}thead th{position:sticky;top:0;background:var(--gch-white);z-index:1}thead th:not(:first-child){min-width:9.5rem}thead span,thead small,thead b{display:block}thead span{font:800 .9rem/1 "JetBrains Mono",monospace;color:var(--gch-text-primary)}thead small{margin-top:.35rem;color:var(--gch-text-muted);font:500 .72rem/1.3 "Outfit",sans-serif}thead b{margin-top:.65rem;color:var(--gch-gold-text);font:700 .56rem/1 "JetBrains Mono",monospace;text-transform:uppercase}tbody th{font:600 .82rem/1.35 "Outfit",sans-serif}td span{font:700 .58rem/1 "JetBrains Mono",monospace;text-transform:uppercase}.pending{color:var(--gch-text-muted)}.plans__note{max-width:66ch;margin-top:1rem;font-size:.86rem}.plans__note strong{color:var(--gch-text-primary)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>