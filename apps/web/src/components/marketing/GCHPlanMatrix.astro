---
import GCHHudLabel from "./GCHHudLabel.astro";
const tiers=[
 {name:"SEED",fit:"Starting foundation",features:[true,true,false,false]},
 {name:"FRUIT",fit:"Growing presence",features:[true,true,true,false]},
 {name:"HARVEST",fit:"Expanded system",features:[true,true,true,true]},
 {name:"LABORER",fit:"Managed / advanced",features:[true,true,true,true]},
];
const rows=["Core website / builder access","Hosting foundation","Growth / visibility layer","Advanced managed support"];
---
<section class="plans" id="plan-matrix" aria-labelledby="plans-title">
 <header><GCHHudLabel index="28" label="Plans / tier comparison"/><h2 id="plans-title">Compare capabilities before price.</h2><p>The established tier names are shown here without invented pricing. Final prices, billing periods, limits, and entitlements should be read from the canonical catalog before launch.</p></header>
 <div class="plans__wrap" role="region" aria-label="Tier capability comparison" tabindex="0">
  <table><caption class="sr-only">Comparison of SEED, FRUIT, HARVEST, and LABORER capability tiers</caption><thead><tr><th scope="col">Capability</th>{tiers.map(t=><th scope="col"><span>{t.name}</span><small>{t.fit}</small><b>Catalog pricing</b></th>)}</tr></thead><tbody>{rows.map((row,r)=><tr><th scope="row">{row}</th>{tiers.map(t=><td><span class={t.features[r]?"yes":"no"}>{t.features[r]?"Included":"Not in baseline"}</span></td>)}</tr>)}</tbody></table>
 </div>
 <p class="plans__note">Capability labels are a wireframe-level structure, not a billing contract. Product registry data remains authoritative.</p>
</section>
<style>
.plans{padding-block:clamp(4rem,8vw,7rem)}.plans header{max-width:54rem}.plans h2{max-width:14ch;margin:.8rem 0 1rem;font:800 clamp(2rem,4.6vw,4.3rem)/.98 "JetBrains Mono",monospace;letter-spacing:-.05em;text-transform:uppercase}.plans header p,.plans__note{color:var(--gch-text-secondary);font:400 1rem/1.6 "Outfit",sans-serif}.plans__wrap{overflow:auto;margin-top:2rem;border:1px solid var(--gch-border-light);border-radius:1rem;background:var(--gch-white)}.plans__wrap:focus-visible{outline:2px solid var(--gch-blue);outline-offset:4px}table{width:100%;min-width:760px;border-collapse:collapse}th,td{padding:1rem;border-bottom:1px solid var(--gch-border-light);border-right:1px solid var(--gch-border-light);text-align:left}thead th{position:sticky;top:0;background:var(--gch-white);z-index:1}thead th:not(:first-child){min-width:9.5rem}thead span,thead small,thead b{display:block}thead span{font:800 .9rem/1 "JetBrains Mono",monospace;color:var(--gch-text-primary)}thead small{margin-top:.35rem;color:var(--gch-text-muted);font:500 .72rem/1.3 "Outfit",sans-serif}thead b{margin-top:.65rem;color:var(--gch-gold-text);font:700 .56rem/1 "JetBrains Mono",monospace;text-transform:uppercase}tbody th{font:600 .82rem/1.35 "Outfit",sans-serif}td span{font:700 .58rem/1 "JetBrains Mono",monospace;text-transform:uppercase}.yes{color:var(--gch-gold-text)}.no{color:var(--gch-text-muted)}.plans__note{max-width:62ch;margin-top:1rem;font-size:.86rem}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>