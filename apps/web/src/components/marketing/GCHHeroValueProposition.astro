---
import GCHHudLabel from "./GCHHudLabel.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  mediaSrc?: string;
  mediaAlt?: string;
}

const {
  eyebrow = "Faith-forward · Tech-confident",
  title = "Digital infrastructure built to serve the mission.",
  body = "Glory Cloud Hosts brings websites, hosting, marketing, ministry technology, and SaaS tools into one connected digital relationship.",
  primaryHref = "#goal-selector",
  primaryLabel = "Find my starting point",
  secondaryHref = "#solution-portals",
  secondaryLabel = "Explore offerings",
  mediaSrc,
  mediaAlt = "Church ministry and technology working together",
} = Astro.props;
---

<section class="gch-hero" data-gch-surface="dark" aria-labelledby="gch-hero-title">
  <div class="gch-hero__ember" aria-hidden="true"></div>
  <div class="gch-hero__inner">
    <div class="gch-hero__copy">
      <GCHHudLabel index="04" label={eyebrow} tone="light" />
      <h1 id="gch-hero-title">{title}</h1>
      <p>{body}</p>
      <div class="gch-hero__actions" aria-label="Hero actions">
        <a class="gch-hero__primary" href={primaryHref}>{primaryLabel}</a>
        <a class="gch-hero__secondary" href={secondaryHref}>{secondaryLabel}<span aria-hidden="true">→</span></a>
      </div>
      <div class="gch-hero__trust" aria-label="GCH focus areas">
        <span>MARKETING</span><span>MINISTRY</span><span>HOSTING</span><span>TOOLS</span>
      </div>
    </div>

    <figure class="gch-hero__media">
      {mediaSrc ? (
        <img src={mediaSrc} alt={mediaAlt} loading="eager" fetchpriority="high" />
      ) : (
        <div class="gch-hero__media-fallback" role="img" aria-label={mediaAlt}>
          <div class="gch-hero__camera" aria-hidden="true"></div>
          <div class="gch-hero__stage" aria-hidden="true"></div>
          <div class="gch-hero__screen" aria-hidden="true">
            <span>LIVE</span>
            <strong>MISSION → DIGITAL REACH</strong>
          </div>
        </div>
      )}
      <figcaption>
        <GCHHudLabel index="POV" label="Ministry + technology in one frame" tone="light" />
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .gch-hero {
    position: relative;
    min-height: min(92vh, 58rem);
    overflow: hidden;
    color: var(--gch-text-primary-dark);
    background:
      radial-gradient(circle at 82% 18%, rgba(232,160,32,.16), transparent 30%),
      radial-gradient(circle at 68% 72%, rgba(72,114,184,.12), transparent 34%),
      var(--gch-brand-dark);
  }

  .gch-hero__ember {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--gch-gradient-ember);
    transform-origin: left center;
    animation: gch-horizon 1.1s cubic-bezier(.2,.7,.2,1) both;
  }

  .gch-hero__inner {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(24rem, .95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .gch-hero__copy { position: relative; z-index: 2; }

  .gch-hero h1 {
    max-width: 10.5ch;
    margin: 1rem 0 1.25rem;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: clamp(2.8rem, 6.2vw, 6.3rem);
    font-weight: 800;
    line-height: .95;
    letter-spacing: -.06em;
    text-transform: uppercase;
  }

  .gch-hero p {
    max-width: 58ch;
    margin: 0;
    color: var(--gch-text-secondary-dark);
    font: 400 clamp(1rem,1.5vw,1.15rem)/1.7 "Outfit", system-ui, sans-serif;
  }

  .gch-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .9rem;
    margin-top: 2rem;
  }

  .gch-hero__primary,
  .gch-hero__secondary {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    padding-inline: 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    font: 700 .92rem/1 "Outfit", system-ui, sans-serif;
  }

  .gch-hero__primary { background: var(--gch-gold-dark); color: var(--gch-brand-dark); }
  .gch-hero__secondary { border: 1px solid rgba(242,239,232,.24); color: var(--gch-text-primary-dark); }
  .gch-hero__primary:focus-visible,
  .gch-hero__secondary:focus-visible { outline: 2px solid var(--gch-blue-dark-safe); outline-offset: 4px; }

  .gch-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    margin-top: 2rem;
    color: rgba(242,239,232,.52);
    font: 600 .64rem/1 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: .11em;
  }

  .gch-hero__media {
    position: relative;
    margin: 0;
    min-height: 34rem;
    border: 1px solid var(--gch-border-dark);
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--gch-surface-default);
    box-shadow: 0 32px 80px rgba(0,0,0,.3);
    animation: gch-media-settle .8s cubic-bezier(.2,.7,.2,1) both;
  }

  .gch-hero__media img { width:100%; height:100%; min-height:34rem; object-fit:cover; display:block; }
  .gch-hero__media::after {
    content:""; position:absolute; inset:0; pointer-events:none;
    background: linear-gradient(180deg, rgba(11,13,18,.04), rgba(11,13,18,.5));
  }

  .gch-hero__media-fallback {
    position:absolute; inset:0;
    background:
      linear-gradient(115deg, rgba(11,13,18,.05), rgba(11,13,18,.65)),
      radial-gradient(circle at 72% 28%, rgba(232,160,32,.32), transparent 22%),
      linear-gradient(135deg, #252a37, #10131a 62%, #2e3347);
  }

  .gch-hero__camera { position:absolute; left:-7%; bottom:8%; width:48%; height:44%; border-radius:2rem; background:#07090d; transform:rotate(-7deg); box-shadow:inset 0 0 0 1px rgba(255,255,255,.06); }
  .gch-hero__camera::after { content:""; position:absolute; right:-15%; top:20%; width:42%; aspect-ratio:1; border:12px solid #171b25; border-radius:50%; background:#050608; }
  .gch-hero__stage { position:absolute; right:8%; top:12%; width:58%; height:54%; border-radius:1rem; background:linear-gradient(160deg,rgba(232,160,32,.28),rgba(72,114,184,.16)),linear-gradient(180deg,#353b4a,#11141a); box-shadow:0 0 70px rgba(232,160,32,.12); }
  .gch-hero__screen { position:absolute; right:5%; bottom:7%; width:54%; padding:1rem; border:1px solid rgba(147,180,223,.28); border-radius:.8rem; background:rgba(11,13,18,.78); backdrop-filter:blur(8px); z-index:2; }
  .gch-hero__screen span { color:var(--gch-blue-dark-safe); font:700 .62rem/1 "JetBrains Mono",monospace; letter-spacing:.12em; }
  .gch-hero__screen strong { display:block; margin-top:.5rem; color:var(--gch-text-primary-dark); font:700 .78rem/1.35 "JetBrains Mono",monospace; }

  .gch-hero figcaption { position:absolute; left:1rem; bottom:1rem; z-index:3; padding:.6rem .75rem; border-radius:.55rem; background:rgba(11,13,18,.72); backdrop-filter:blur(10px); }

  @keyframes gch-horizon { from { transform:scaleX(0); opacity:0; } to { transform:scaleX(1); opacity:1; } }
  @keyframes gch-media-settle { from { transform:translateY(18px) scale(.985); opacity:.3; } to { transform:none; opacity:1; } }

  @media (max-width: 860px) {
    .gch-hero { min-height:auto; }
    .gch-hero__inner { grid-template-columns:1fr; padding-block:4rem; }
    .gch-hero h1 { max-width:12ch; }
    .gch-hero__media { min-height:24rem; }
    .gch-hero__media img { min-height:24rem; }
  }

  @media (max-width: 560px) {
    .gch-hero__media { min-height:20rem; border-radius:1.2rem; }
    .gch-hero__media img { min-height:20rem; }
    .gch-hero__actions { display:grid; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gch-hero__ember,
    .gch-hero__media { animation:none; }
  }
</style>
