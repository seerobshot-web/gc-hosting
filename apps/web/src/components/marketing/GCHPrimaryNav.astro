---
import GCHHudLabel from "./GCHHudLabel.astro";
import { primaryNavItems, siteRoutes } from "../../config/site-routes";

const items = primaryNavItems;
const mobileDescriptions: Record<string, string> = {
  Marketing: "Brand · Websites · Growth",
  Ministry: "Ministry technology · GLinks · Streaming",
  Hosting: "Hosting · Domains · Infrastructure",
  Tools: "Digital products and software",
  Deals: "Seed · Fruit · Harvest",
  Resources: "Guides · Checklists · Learning",
};
---

<header class="gch-nav-shell" data-gch-nav-surface="light">
  <nav class="gch-nav" aria-label="Primary navigation">
    <a class="gch-nav__brand" href={siteRoutes.home} aria-label="Glory Cloud Hosts home">
      <span class="gch-nav__brand-asset" aria-hidden="true">
        <span class="gch-nav__mark">GCH</span>
      </span>
      <span class="gch-nav__wordmark">Glory Cloud Hosts</span>
    </a>

    <div class="gch-nav__links" aria-label="Main sections">
      {items.map((item) => (
        <a class="gch-nav__link" href={item.href}>
          <span class="gch-nav__index">{item.index}</span>
          <span class="gch-nav__label">{item.label}</span>
          <span class="gch-nav__datum" aria-hidden="true"></span>
        </a>
      ))}
    </div>

    <div class="gch-nav__actions">
      <a class="gch-nav__text-action" href={siteRoutes.portal}>Portal</a>
      <a class="gch-nav__primary" href={siteRoutes.start}>Get started</a>
    </div>

    <details class="gch-nav__mobile">
      <summary aria-label="Open navigation">Menu</summary>
      <div class="gch-nav__mobile-panel">
        {items.map((item) => (
          <a class="gch-nav__mobile-link" href={item.href}>
            <GCHHudLabel index={item.index} label={item.label} />
            <small>{mobileDescriptions[item.label]}</small>
          </a>
        ))}
        <div class="gch-nav__mobile-divider" aria-hidden="true"></div>
        <a class="gch-nav__mobile-link gch-nav__mobile-link--utility" href={siteRoutes.portal}>
          <GCHHudLabel label="Portal" tone="muted" />
          <small>Existing customer access</small>
        </a>
        <a class="gch-nav__primary" href={siteRoutes.start}>Get started</a>
      </div>
    </details>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>(".gch-nav-shell");
  const sections = [...document.querySelectorAll<HTMLElement>("[data-gch-surface]")];

  if (nav && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const active = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!(active?.target instanceof HTMLElement)) return;

        const surface = active.target.dataset.gchSurface;
        nav.dataset.gchNavSurface = surface === "dark" ? "dark" : "light";
      },
      {
        rootMargin: "-15% 0px -70% 0px",
        threshold: [0, 0.25, 0.5, 0.75],
      },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .gch-nav-shell {
    --nav-bg: rgba(245, 240, 230, 0.94);
    --nav-fg: var(--gch-brand-dark);
    --nav-muted: var(--gch-text-secondary);
    --nav-border: rgba(8, 13, 15, 0.1);
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--nav-border);
    background: var(--nav-bg);
    color: var(--nav-fg);
    backdrop-filter: blur(18px);
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .gch-nav-shell[data-gch-nav-surface="dark"] {
    --nav-bg: rgba(8, 13, 15, 0.94);
    --nav-fg: var(--gch-text-primary-dark);
    --nav-muted: var(--gch-text-secondary-dark);
    --nav-border: rgba(245, 240, 230, 0.1);
  }

  .gch-nav-shell[data-gch-nav-surface="overlay"] {
    --nav-bg: rgba(8, 13, 15, 0.76);
    --nav-fg: var(--gch-text-primary-dark);
    --nav-muted: var(--gch-text-secondary-dark);
    --nav-border: rgba(245, 240, 230, 0.1);
  }

  .gch-nav {
    width: min(100% - 2rem, 1240px);
    min-height: 5rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
  }

  .gch-nav__brand,
  .gch-nav__link,
  .gch-nav__text-action,
  .gch-nav__primary,
  .gch-nav__mobile-link {
    text-decoration: none;
  }

  .gch-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--nav-fg);
  }

  .gch-nav__brand-asset {
    display: grid;
    place-items: center;
    min-width: 3.15rem;
    height: 2.1rem;
  }

  .gch-nav__mark {
    display: grid;
    place-items: center;
    min-width: 3.05rem;
    height: 2rem;
    border: 1px solid color-mix(in srgb, var(--gch-gold) 65%, transparent);
    border-radius: 0.55rem;
    color: var(--gch-gold-dark);
    font: 800 0.68rem/1 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.08em;
  }

  .gch-nav__wordmark {
    font: 800 0.77rem/1 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .gch-nav__links {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: clamp(0.65rem, 1.35vw, 1.15rem);
  }

  .gch-nav__link {
    position: relative;
    min-height: 5rem;
    display: grid;
    grid-template-columns: auto auto;
    align-content: center;
    column-gap: 0.32rem;
    color: var(--nav-fg);
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }

  .gch-nav__index {
    color: var(--nav-muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .gch-nav__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    transition: color 160ms ease, letter-spacing 160ms ease;
  }

  .gch-nav__datum {
    position: absolute;
    left: 0;
    bottom: 1.05rem;
    width: 2rem;
    height: 2px;
    background: var(--gch-gold-dark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
  }

  .gch-nav__link:hover .gch-nav__label,
  .gch-nav__link:focus-visible .gch-nav__label {
    color: var(--gch-gold-dark);
    letter-spacing: 0.075em;
  }

  .gch-nav__link:hover .gch-nav__datum,
  .gch-nav__link:focus-visible .gch-nav__datum {
    transform: scaleX(1);
  }

  .gch-nav__link:focus-visible,
  .gch-nav__text-action:focus-visible,
  .gch-nav__mobile summary:focus-visible {
    outline: 2px solid var(--gch-blue);
    outline-offset: 4px;
  }

  .gch-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .gch-nav__text-action {
    color: var(--nav-muted);
    font: 700 0.72rem/1 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gch-nav__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: 1.05rem;
    border-radius: 999px;
    background: var(--gch-gold);
    color: var(--gch-brand-dark);
    font: 700 0.8rem/1 "Outfit", system-ui, sans-serif;
    transition: transform 160ms ease, filter 160ms ease;
  }

  .gch-nav__primary:hover,
  .gch-nav__primary:focus-visible {
    transform: translateY(-1px);
    filter: brightness(1.05);
    outline: 2px solid var(--gch-blue);
    outline-offset: 3px;
  }

  .gch-nav__mobile { display: none; }

  @media (max-width: 1120px) and (min-width: 981px) {
    .gch-nav {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .gch-nav__links {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      justify-content: center;
      gap: 0 1rem;
    }

    .gch-nav__link {
      min-height: 2.25rem;
    }

    .gch-nav__datum {
      bottom: 0.28rem;
    }
  }

  @media (max-width: 980px) {
    .gch-nav {
      grid-template-columns: 1fr auto;
      min-height: 4.4rem;
    }

    .gch-nav__links,
    .gch-nav__actions { display: none; }

    .gch-nav__mobile {
      display: block;
      position: relative;
    }

    .gch-nav__mobile summary {
      min-width: 44px;
      min-height: 44px;
      display: grid;
      place-items: center;
      list-style: none;
      cursor: pointer;
      color: var(--nav-fg);
      font: 700 0.7rem/1 "JetBrains Mono", ui-monospace, monospace;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .gch-nav__mobile summary::-webkit-details-marker { display: none; }

    .gch-nav__mobile-panel {
      position: absolute;
      right: 0;
      top: calc(100% + 0.65rem);
      width: min(24rem, calc(100vw - 2rem));
      display: grid;
      gap: 0.25rem;
      padding: 0.9rem;
      border: 1px solid var(--gch-border-dark);
      border-radius: 1rem;
      background: var(--gch-brand-dark);
      box-shadow: 0 18px 50px rgba(11, 13, 18, 0.2);
    }

    .gch-nav__mobile-link {
      min-height: 44px;
      display: grid;
      gap: 0.42rem;
      padding: 0.8rem;
      border-radius: 0.7rem;
      color: var(--gch-text-primary-dark);
    }

    .gch-nav__mobile-link small {
      color: var(--gch-text-secondary-dark);
      font: 500 0.74rem/1.35 "Outfit", system-ui, sans-serif;
    }

    .gch-nav__mobile-link:hover,
    .gch-nav__mobile-link:focus-visible {
      background: color-mix(in srgb, var(--gch-surface-default) 92%, transparent);
      outline: 2px solid var(--gch-blue);
      outline-offset: 2px;
    }

    .gch-nav__mobile-divider {
      height: 1px;
      margin: 0.4rem 0;
      background: var(--gch-border-dark);
    }

    .gch-nav__mobile-link--utility {
      border: 1px solid var(--gch-border-dark);
    }
  }

  @media (max-width: 620px) {
    .gch-nav__wordmark { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gch-nav-shell,
    .gch-nav__label,
    .gch-nav__datum,
    .gch-nav__primary { transition: none; }

    .gch-nav__primary:hover,
    .gch-nav__primary:focus-visible { transform: none; }
  }
</style>
