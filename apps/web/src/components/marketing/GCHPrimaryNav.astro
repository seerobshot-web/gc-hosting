---
import GCHHudLabel from "./GCHHudLabel.astro";

const items = [
  { index: "01", label: "Marketing", href: "/marketing" },
  { index: "02", label: "Ministry", href: "/ministry" },
  { index: "03", label: "Hosting", href: "/hosting" },
  { index: "04", label: "Tools", href: "/tools" },
  { index: "05", label: "Resources", href: "/resources" },
];
---

<header class="gch-nav-shell" data-gch-surface="light">
  <nav class="gch-nav" aria-label="Primary navigation">
    <a class="gch-nav__brand" href="/" aria-label="Glory Cloud Hosts home">
      <span class="gch-nav__mark" aria-hidden="true">GC</span>
      <span class="gch-nav__wordmark">Glory Cloud Hosts</span>
    </a>

    <div class="gch-nav__links" aria-label="Main sections">
      {items.map((item) => (
        <a class="gch-nav__link" href={item.href}>
          <GCHHudLabel index={item.index} label={item.label} tone="muted" />
        </a>
      ))}
    </div>

    <div class="gch-nav__actions">
      <a class="gch-nav__text-action" href="/resources">Search</a>
      <a class="gch-nav__text-action" href="/portal">Sign in</a>
      <a class="gch-nav__primary" href="/start">Get started</a>
    </div>

    <details class="gch-nav__mobile">
      <summary aria-label="Open navigation">Menu</summary>
      <div class="gch-nav__mobile-panel">
        {items.map((item) => (
          <a class="gch-nav__mobile-link" href={item.href}>
            <GCHHudLabel index={item.index} label={item.label} />
          </a>
        ))}
        <a class="gch-nav__primary" href="/start">Get started</a>
      </div>
    </details>
  </nav>
</header>

<style>
  .gch-nav-shell {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--gch-border-light);
    background: color-mix(in srgb, var(--gch-cream) 92%, transparent);
    backdrop-filter: blur(16px);
  }

  .gch-nav {
    width: min(100% - 2rem, 1180px);
    min-height: 4.75rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .gch-nav__brand,
  .gch-nav__link,
  .gch-nav__text-action,
  .gch-nav__primary,
  .gch-nav__mobile-link {
    text-decoration: none;
  }

  .gch-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--gch-text-primary);
  }

  .gch-nav__mark {
    display: grid;
    place-items: center;
    width: 2.2rem;
    aspect-ratio: 1;
    border-radius: 0.65rem;
    background: var(--gch-gold);
    color: var(--gch-brand-dark);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .gch-nav__wordmark {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .gch-nav__links {
    display: flex;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .gch-nav__link {
    padding-block: 1.65rem;
    border-bottom: 2px solid transparent;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .gch-nav__link:hover,
  .gch-nav__link:focus-visible {
    border-color: var(--gch-gold);
    transform: translateY(-1px);
    outline: none;
  }

  .gch-nav__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .gch-nav__text-action {
    color: var(--gch-text-secondary);
    font: 600 0.82rem/1 "Outfit", system-ui, sans-serif;
  }

  .gch-nav__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding-inline: 1rem;
    border-radius: 999px;
    background: var(--gch-gold);
    color: var(--gch-brand-dark);
    font: 700 0.82rem/1 "Outfit", system-ui, sans-serif;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .gch-nav__primary:hover,
  .gch-nav__primary:focus-visible {
    transform: translateY(-2px);
    filter: brightness(1.05);
    outline: 2px solid var(--gch-blue);
    outline-offset: 3px;
  }

  .gch-nav__mobile { display: none; }

  @media (max-width: 980px) {
    .gch-nav {
      grid-template-columns: 1fr auto;
      min-height: 4.25rem;
    }

    .gch-nav__links,
    .gch-nav__actions { display: none; }

    .gch-nav__mobile {
      display: block;
      position: relative;
    }

    .gch-nav__mobile summary {
      list-style: none;
      cursor: pointer;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .gch-nav__mobile summary::-webkit-details-marker { display: none; }

    .gch-nav__mobile-panel {
      position: absolute;
      right: 0;
      top: calc(100% + 1rem);
      width: min(22rem, calc(100vw - 2rem));
      display: grid;
      gap: 0.25rem;
      padding: 1rem;
      border: 1px solid var(--gch-border-light);
      border-radius: 1rem;
      background: var(--gch-white);
      box-shadow: 0 18px 50px rgba(11, 13, 18, 0.12);
    }

    .gch-nav__mobile-link {
      padding: 0.9rem;
      border-radius: 0.7rem;
    }

    .gch-nav__mobile-link:hover,
    .gch-nav__mobile-link:focus-visible {
      background: var(--gch-cream-dim);
      outline: 2px solid var(--gch-blue);
      outline-offset: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gch-nav__link,
    .gch-nav__primary { transition: none; }

    .gch-nav__link:hover,
    .gch-nav__link:focus-visible,
    .gch-nav__primary:hover,
    .gch-nav__primary:focus-visible { transform: none; }
  }
</style>
