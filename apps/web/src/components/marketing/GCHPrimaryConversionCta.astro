---
import GCHHudLabel from "./GCHHudLabel.astro";

interface Action {
  label: string;
  href: string;
  detail: string;
}

interface Props {
  prompt?: string;
  actions?: Action[];
}

const {
  prompt = "What do you need to build?",
  actions = [
    { label: "Start a website", href: "#solution-portals", detail: "Design + launch" },
    { label: "Grow online", href: "#goal-selector", detail: "SEO + Google + marketing" },
    { label: "Move hosting", href: "/hosting", detail: "Migrate + manage" },
  ],
} = Astro.props;
---

<section class="gch-conversion" aria-labelledby="gch-conversion-title">
  <div class="gch-conversion__prompt">
    <GCHHudLabel index="06" label="Primary conversion" />
    <h2 id="gch-conversion-title">{prompt}</h2>
  </div>

  <div class="gch-conversion__actions">
    {actions.map((action, index) => (
      <a class="gch-conversion__action" href={action.href}>
        <span class="gch-conversion__code">0{index + 1}</span>
        <span class="gch-conversion__label">{action.label}</span>
        <span class="gch-conversion__detail">{action.detail}</span>
        <span class="gch-conversion__arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<style>
  .gch-conversion {
    display: grid;
    grid-template-columns: minmax(15rem,.7fr) minmax(0,1.3fr);
    gap: clamp(2rem,5vw,5rem);
    align-items: start;
    padding: clamp(1.5rem,3vw,2.5rem);
    border: 1px solid var(--gch-border-light);
    border-radius: 1.5rem;
    background: var(--gch-white);
    box-shadow: 0 24px 60px rgba(11,13,18,.07);
  }

  .gch-conversion h2 {
    max-width: 12ch;
    margin: .85rem 0 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: clamp(1.6rem,3vw,2.6rem);
    line-height: 1.02;
    letter-spacing: -.04em;
    text-transform: uppercase;
  }

  .gch-conversion__actions { display:grid; gap:.65rem; }

  .gch-conversion__action {
    display:grid;
    grid-template-columns: 2.2rem minmax(0,1fr) auto 2rem;
    gap: .8rem;
    align-items:center;
    min-height: 4.4rem;
    padding: .7rem .85rem;
    border: 1px solid var(--gch-border-light);
    border-radius: 1rem;
    color: var(--gch-text-primary);
    background: var(--gch-cream);
    text-decoration:none;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .gch-conversion__action:hover,
  .gch-conversion__action:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--gch-gold) 55%, var(--gch-border-light));
    background: #fffaf0;
    outline:none;
  }

  .gch-conversion__action:focus-visible { box-shadow: 0 0 0 2px var(--gch-blue); }

  .gch-conversion__code {
    color: var(--gch-gold-text);
    font: 700 .66rem/1 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: .08em;
  }

  .gch-conversion__label { font: 700 1rem/1.25 "Outfit", system-ui, sans-serif; }
  .gch-conversion__detail { color: var(--gch-text-muted); font: 500 .78rem/1.2 "Outfit", system-ui, sans-serif; }
  .gch-conversion__arrow { color: var(--gch-gold-text); font-size:1.1rem; }

  @media (max-width: 760px) {
    .gch-conversion { grid-template-columns:1fr; }
    .gch-conversion h2 { max-width:18ch; }
  }

  @media (max-width: 520px) {
    .gch-conversion__action { grid-template-columns: 2rem 1fr 1.5rem; }
    .gch-conversion__detail { grid-column: 2 / 4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gch-conversion__action { transition:none; }
    .gch-conversion__action:hover,
    .gch-conversion__action:focus-visible { transform:none; }
  }
</style>
