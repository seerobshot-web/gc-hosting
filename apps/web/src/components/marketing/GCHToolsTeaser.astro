---
import GCHHudLabel from "./GCHHudLabel.astro";
import { getHomepageToolTeasers } from "../../content/tools/toolCatalog";
import { siteRoutes } from "../../config/site-routes";

const teaserTools = getHomepageToolTeasers(8);
---

<section class="gch-tools-teaser" aria-labelledby="gch-tools-teaser-title">
  <div class="gch-tools-teaser__inner">
    <header class="gch-tools-teaser__header">
      <div>
        <GCHHudLabel index="24" label="Tools teaser" />
        <h2 id="gch-tools-teaser-title">Tools to help you run and grow your business</h2>
      </div>
      <p>
        GCH offers white-label digital services and software tools for agencies, developers,
        small businesses, and growing organizations. Public cards stay read-only until the
        verified catalog and storefront contract is available.
      </p>
      <a class="gch-tools-teaser__catalog-link" href={siteRoutes.tools}>Open the complete public Tools catalog</a>
    </header>

    <div class="gch-tools-teaser__grid">
      {teaserTools.map((tool) => (
        <article class="gch-tools-teaser__card">
          <span>{tool.availability.value}</span>
          <h3>{tool.displayName}</h3>
          <p>{tool.teaser}</p>
          <small>{tool.pricing.value}</small>
          <a href={tool.detailHref}>Learn more <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .gch-tools-teaser{padding:clamp(4rem,8vw,6.5rem) 0;background:var(--gch-cream-dim)}
  .gch-tools-teaser__inner{width:min(100% - 2rem,1180px);margin-inline:auto}
  .gch-tools-teaser__header{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,30rem);gap:1rem 2rem;align-items:end;margin-bottom:2rem}
  .gch-tools-teaser__header h2{max-width:13ch;margin:.8rem 0 0;font:800 clamp(2rem,4.6vw,4.25rem)/.98 "Outfit",system-ui,sans-serif;letter-spacing:-.05em}
  .gch-tools-teaser__header p{margin:0;color:var(--gch-text-secondary);font:400 1rem/1.65 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__catalog-link{width:max-content;display:inline-flex;align-items:center;justify-content:center;min-height:2.6rem;padding:0 .95rem;border:1px solid var(--gch-border-light);border-radius:999px;background:var(--gch-white);color:var(--gch-text-primary);text-decoration:none;font:700 .84rem/1 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__catalog-link:hover{background:var(--gch-cream);border-color:var(--gch-border-strong)}
  .gch-tools-teaser__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
  .gch-tools-teaser__card{display:grid;gap:.8rem;padding:1rem;border:1px solid var(--gch-border-light);border-radius:1rem;background:var(--gch-white)}
  .gch-tools-teaser__card span,.gch-tools-teaser__card small{color:var(--gch-text-muted);font:700 .62rem/1.3 "JetBrains Mono",ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase}
  .gch-tools-teaser__card h3{margin:0;font:800 1.05rem/1.1 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__card p{margin:0;color:var(--gch-text-secondary);font:400 .93rem/1.55 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__card a{width:max-content;color:var(--gch-text-primary);text-decoration:none;font:700 .88rem/1 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__catalog-link:focus-visible,.gch-tools-teaser__card a:focus-visible{outline:2px solid var(--gch-blue);outline-offset:4px}
  @media(max-width:960px){.gch-tools-teaser__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gch-tools-teaser__header{grid-template-columns:1fr}}
  @media(max-width:560px){.gch-tools-teaser__grid{grid-template-columns:1fr}}
</style>
