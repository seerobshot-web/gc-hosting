---
import GCHHudLabel from "./GCHHudLabel.astro";
import GCHSaaSDemoCard from "./GCHSaaSDemoCard.astro";
import { getDemoRunwayTools } from "../../content/tools/toolCatalog";
import { siteRoutes } from "../../config/site-routes";

const runwayTools = getDemoRunwayTools(6);
---

<section class="gch-tools-teaser" aria-labelledby="gch-tools-teaser-title" data-gch-surface="light">
  <div class="gch-tools-teaser__inner">
    <header class="gch-tools-teaser__header">
      <div>
        <GCHHudLabel index="24" label="GCH Tools" />
        <h2 id="gch-tools-teaser-title">Software that connects the work.</h2>
      </div>
      <div class="gch-tools-teaser__copy">
        <p>
          Explore a curated GCH tool runway. Verified demos open directly; products without a
          verified demo stay in product-detail mode instead of exposing a dead demo action.
        </p>
        <a class="gch-tools-teaser__catalog-link" href={siteRoutes.tools}>
          Open the complete Tools catalog
        </a>
      </div>
    </header>

    <div class="gch-tools-teaser__runway" aria-label="Featured GCH tools and demos">
      {runwayTools.map((tool) => (
        <div class="gch-tools-teaser__slide">
          <GCHSaaSDemoCard tool={tool} compact />
        </div>
      ))}
    </div>

    <div class="gch-tools-teaser__hint" aria-hidden="true">
      <span>Scroll to explore</span>
      <span>──────────→</span>
    </div>
  </div>
</section>

<style>
  .gch-tools-teaser{padding:clamp(4rem,8vw,6.5rem) 0;background:var(--gch-cream-dim)}
  .gch-tools-teaser__inner{width:min(100% - 2rem,1180px);margin-inline:auto}
  .gch-tools-teaser__header{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,31rem);gap:1.5rem 3rem;align-items:end;margin-bottom:2rem}
  .gch-tools-teaser__header h2{max-width:11ch;margin:.8rem 0 0;font:800 clamp(2.2rem,4.9vw,4.8rem)/.96 "Outfit",system-ui,sans-serif;letter-spacing:-.055em}
  .gch-tools-teaser__copy{display:grid;gap:1rem}
  .gch-tools-teaser__copy p{margin:0;color:var(--gch-text-secondary);font:400 1rem/1.65 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__catalog-link{width:max-content;display:inline-flex;align-items:center;justify-content:center;min-height:2.7rem;padding:0 1rem;border:1px solid var(--gch-border-light);border-radius:999px;background:var(--gch-white);color:var(--gch-text-primary);text-decoration:none;font:700 .82rem/1 "Outfit",system-ui,sans-serif}
  .gch-tools-teaser__catalog-link:hover{border-color:var(--gch-gold)}
  .gch-tools-teaser__catalog-link:focus-visible{outline:2px solid var(--gch-blue);outline-offset:4px}
  .gch-tools-teaser__runway{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(19rem,34rem);gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;padding:.35rem .2rem 1.1rem;overscroll-behavior-inline:contain}
  .gch-tools-teaser__slide{scroll-snap-align:center}
  .gch-tools-teaser__hint{display:flex;justify-content:flex-end;gap:.7rem;color:var(--gch-text-muted);font:700 .58rem/1 "JetBrains Mono",ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase}
  @media(max-width:860px){.gch-tools-teaser__header{grid-template-columns:1fr}.gch-tools-teaser__runway{grid-auto-columns:minmax(18rem,88vw)}}
  @media(prefers-reduced-motion:reduce){.gch-tools-teaser__runway{scroll-behavior:auto}}
</style>
