---
interface Props {
  index?: string;
  label: string;
  tone?: "gold" | "blue" | "muted" | "light";
}

const { index, label, tone = "gold" } = Astro.props;
---

<span class={`gch-hud-label gch-hud-label--${tone}`}>
  {index && <span class="gch-hud-label__index">{index}</span>}
  <span>{label}</span>
</span>

<style>
  .gch-hud-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .gch-hud-label__index {
    opacity: 0.62;
  }

  .gch-hud-label--gold { color: var(--gch-gold-text); }
  .gch-hud-label--blue { color: var(--gch-blue); }
  .gch-hud-label--muted { color: var(--gch-text-muted); }
  .gch-hud-label--light { color: var(--gch-gold-dark); }
</style>
