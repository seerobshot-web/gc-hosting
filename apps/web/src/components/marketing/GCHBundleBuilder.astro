---
import GCHHudLabel from "./GCHHudLabel.astro";
import { siteRoutes } from "../../config/site-routes";
const services=[
 {key:"website",label:"Website",copy:"Design or redesign the core public experience."},
 {key:"hosting",label:"Hosting",copy:"Managed infrastructure, domains, SSL, and migrations."},
 {key:"brand",label:"Brand",copy:"Identity, typography, color, and application system."},
 {key:"seo",label:"SEO",copy:"Technical baseline, content strategy, and search growth."},
 {key:"local",label:"Google / Local",copy:"Business profile and local-discovery alignment."},
 {key:"glinks",label:"GLinks",copy:"Mobile-first ministry and campaign connection layer."},
];
---
<section class="bundle" id="package-builder" aria-labelledby="bundle-title" data-bundle-builder>
 <header><GCHHudLabel index="27" label="Bundle / package builder"/><h2 id="bundle-title">Build around the mission, not a preset box.</h2><p>Select the capabilities that belong together. This wireframe teaches the connected solution before canonical catalog pricing is introduced.</p></header>
 <div class="bundle__layout">
  <div class="bundle__choices">
   {services.map((s,index)=><label class="bundle__choice"><input type="checkbox" value={s.key} checked={index<2}/><span class="bundle__check" aria-hidden="true"></span><span><strong>{s.label}</strong><small>{s.copy}</small></span></label>)}
  </div>
  <aside class="bundle__summary" aria-live="polite"><GCHHudLabel index="CONFIG" label="Selected system" tone="light"/><strong data-bundle-count>2 capabilities</strong><p data-bundle-copy>Website + Hosting</p><div class="bundle__path"><span>Discover</span><i>→</i><span>Configure</span><i>→</i><span>Confirm</span></div><a data-bundle-start href={siteRoutes.start}>Review this starting point <span aria-hidden="true">→</span></a></aside>
 </div>
</section>
<script>
 document.querySelectorAll("[data-bundle-builder]").forEach((root)=>{const inputs=Array.from(root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));const count=root.querySelector("[data-bundle-count]");const copy=root.querySelector("[data-bundle-copy]");const startLink=root.querySelector<HTMLAnchorElement>("[data-bundle-start]");const update=()=>{const selected=inputs.filter(i=>i.checked);const labels=selected.map(i=>i.closest("label")?.querySelector("strong")?.textContent).filter(Boolean);if(count)count.textContent=labels.length+" "+(labels.length===1?"capability":"capabilities");if(copy)copy.textContent=labels.length?labels.join(" + "):"Choose at least one capability";if(startLink){const params=new URLSearchParams(selected.map((input)=>["capability",input.value]));startLink.href=siteRoutes.start+"?"+params.toString();}};inputs.forEach(i=>i.addEventListener("change",update));update();});
</script>
<style>
.bundle{padding:clamp(3rem,7vw,6rem);border-radius:1.6rem;background:var(--gch-cream-dim)}.bundle header{max-width:48rem}.bundle h2{max-width:15ch;margin:.8rem 0 1rem;font:800 clamp(2rem,4.5vw,4rem)/.98 "JetBrains Mono",monospace;letter-spacing:-.05em;text-transform:uppercase}.bundle header p{color:var(--gch-text-secondary);font:400 1rem/1.65 "Outfit",sans-serif}.bundle__layout{display:grid;grid-template-columns:1.15fr .85fr;gap:2rem;margin-top:2rem}.bundle__choices{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.bundle__choice{display:grid;grid-template-columns:auto 1fr;gap:.8rem;align-items:start;padding:1rem;border:1px solid var(--gch-border-light);border-radius:.9rem;background:var(--gch-white);cursor:pointer}.bundle__choice input{position:absolute;opacity:0;pointer-events:none}.bundle__check{width:1.1rem;aspect-ratio:1;border:1px solid var(--gch-border-strong);border-radius:.3rem;margin-top:.1rem}.bundle__choice:has(input:checked){border-color:var(--gch-gold)}.bundle__choice input:checked+.bundle__check{background:var(--gch-gold);box-shadow:inset 0 0 0 3px var(--gch-white)}.bundle__choice:has(input:focus-visible){outline:2px solid var(--gch-blue);outline-offset:3px}.bundle__choice strong,.bundle__choice small{display:block}.bundle__choice strong{font:700 .9rem/1.1 "JetBrains Mono",monospace;text-transform:uppercase}.bundle__choice small{margin-top:.4rem;color:var(--gch-text-secondary);font:400 .78rem/1.4 "Outfit",sans-serif}.bundle__summary{align-self:start;position:sticky;top:6.5rem;padding:1.4rem;border-radius:1rem;background:var(--gch-brand-dark);color:var(--gch-text-primary-dark)}.bundle__summary>strong{display:block;margin:1.2rem 0 .5rem;font:800 clamp(1.5rem,3vw,2.4rem)/1 "JetBrains Mono",monospace;text-transform:uppercase}.bundle__summary>p{color:var(--gch-text-secondary-dark);font:500 .95rem/1.5 "Outfit",sans-serif}.bundle__path{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin:1.2rem 0;color:var(--gch-blue-dark-safe);font:700 .58rem/1 "JetBrains Mono",monospace;text-transform:uppercase}.bundle__summary a{display:inline-flex;gap:.5rem;color:var(--gch-text-primary-dark);text-decoration:none;font:700 .85rem/1 "Outfit",sans-serif}.bundle__summary a:focus-visible{outline:2px solid var(--gch-blue-dark-safe);outline-offset:4px}@media(max-width:820px){.bundle__layout{grid-template-columns:1fr}.bundle__summary{position:static}}@media(max-width:560px){.bundle{padding:1.2rem}.bundle__choices{grid-template-columns:1fr}}
</style>
