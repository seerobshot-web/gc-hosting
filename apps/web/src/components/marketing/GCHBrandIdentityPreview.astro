---
const assets = [
  { key: "mark", label: "Primary mark", note: "Core identity symbol and wordmark relationship." },
  { key: "type", label: "Typography", note: "Display, body, and visitor-cue hierarchy working together." },
  { key: "color", label: "Color system", note: "GCH Gold, Sacred Ember energy, ministry blue, and neutral surfaces." },
  { key: "web", label: "Web application", note: "Brand decisions translated into interface patterns rather than static boards." },
];
---

<div class="gch-brand-preview" data-brand-preview>
  <div class="gch-brand-preview__desk" aria-label="Brand identity system preview">
    <button class="gch-brand-preview__asset gch-brand-preview__asset--mark" type="button" data-brand-asset="mark" aria-pressed="true">
      <span class="gch-brand-preview__asset-label">01 · Primary mark</span>
      <strong>GLORY<br/>CLOUD HOSTS</strong>
      <i aria-hidden="true"></i>
    </button>

    <button class="gch-brand-preview__asset gch-brand-preview__asset--type" type="button" data-brand-asset="type" aria-pressed="false">
      <span class="gch-brand-preview__asset-label">02 · Typography</span>
      <b>BUILD WITH CLARITY.</b>
      <small>Outfit carries the body voice. JetBrains Mono marks the system cues.</small>
    </button>

    <button class="gch-brand-preview__asset gch-brand-preview__asset--color" type="button" data-brand-asset="color" aria-pressed="false">
      <span class="gch-brand-preview__asset-label">03 · Color system</span>
      <span class="gch-brand-preview__swatches" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <small>Warmth, infrastructure, signal, and restraint.</small>
    </button>

    <button class="gch-brand-preview__asset gch-brand-preview__asset--web" type="button" data-brand-asset="web" aria-pressed="false">
      <span class="gch-brand-preview__asset-label">04 · Web application</span>
      <div class="gch-brand-preview__mini-web" aria-hidden="true"><i></i><b></b><span></span><span></span><span></span></div>
    </button>
  </div>

  <div class="gch-brand-preview__annotation" aria-live="polite">
    <span>Selected asset</span>
    <strong data-brand-title>{assets[0].label}</strong>
    <p data-brand-note>{assets[0].note}</p>
  </div>
</div>

<script define:vars={{ assets }}>
  document.querySelectorAll("[data-brand-preview]").forEach((root) => {
    const title = root.querySelector("[data-brand-title]");
    const note = root.querySelector("[data-brand-note]");
    root.querySelectorAll("[data-brand-asset]").forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.getAttribute("data-brand-asset");
        root.querySelectorAll("[data-brand-asset]").forEach((item) => item.setAttribute("aria-pressed", item === button ? "true" : "false"));
        const item = assets.find((asset) => asset.key === key);
        if (item && title && note) { title.textContent = item.label; note.textContent = item.note; }
      });
    });
  });
</script>

<style>
  .gch-brand-preview { position:absolute; inset:0; z-index:2; display:grid; grid-template-columns:minmax(0,1fr) minmax(11rem,.34fr); gap:1rem; padding:clamp(1rem,2.4vw,2rem); }
  .gch-brand-preview__desk { position:relative; min-height:0; border-radius:1rem; background:linear-gradient(145deg,#f8f5ef,#ede9e2); overflow:hidden; }
  .gch-brand-preview__asset { position:absolute; border:1px solid rgba(26,26,34,.12); border-radius:.8rem; background:#fff; color:#1a1a22; text-align:left; cursor:pointer; box-shadow:0 10px 28px rgba(11,13,18,.08); transition:transform 180ms ease,border-color 180ms ease,box-shadow 180ms ease; }
  .gch-brand-preview__asset:hover,.gch-brand-preview__asset:focus-visible,.gch-brand-preview__asset[aria-pressed="true"] { border-color:var(--gch-gold); box-shadow:0 16px 38px rgba(11,13,18,.13); transform:translateY(-3px); }
  .gch-brand-preview__asset:focus-visible { outline:2px solid var(--gch-blue); outline-offset:3px; }
  .gch-brand-preview__asset-label { display:block; margin-bottom:.8rem; color:var(--gch-gold-text); font:700 .55rem/1 "JetBrains Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .gch-brand-preview__asset--mark { left:6%; top:8%; width:40%; height:38%; padding:1rem; }
  .gch-brand-preview__asset--mark strong { font:800 clamp(1.2rem,3vw,2.4rem)/.9 "JetBrains Mono",monospace; letter-spacing:-.05em; }
  .gch-brand-preview__asset--mark i { position:absolute; right:1rem; bottom:1rem; width:3.1rem; height:3.1rem; border-radius:50%; background:conic-gradient(from 200deg,#e8566a,#f0862e,#e8a020,#e8566a); }
  .gch-brand-preview__asset--type { right:6%; top:10%; width:42%; min-height:32%; padding:1rem; transform:rotate(2deg); }
  .gch-brand-preview__asset--type b { display:block; font:800 clamp(1rem,2.2vw,1.7rem)/1 "JetBrains Mono",monospace; }
  .gch-brand-preview__asset--type small,.gch-brand-preview__asset--color small { display:block; margin-top:.6rem; color:#5b564c; font:500 .66rem/1.4 "Outfit",sans-serif; }
  .gch-brand-preview__asset--color { left:12%; bottom:8%; width:38%; min-height:28%; padding:1rem; transform:rotate(-2deg); }
  .gch-brand-preview__swatches { display:flex; gap:.35rem; }
  .gch-brand-preview__swatches i { width:2.1rem; aspect-ratio:1; border-radius:.4rem; }
  .gch-brand-preview__swatches i:nth-child(1){background:#0b0d12}.gch-brand-preview__swatches i:nth-child(2){background:#d4900c}.gch-brand-preview__swatches i:nth-child(3){background:#4872b8}.gch-brand-preview__swatches i:nth-child(4){background:linear-gradient(135deg,#e8566a,#e8a020)}
  .gch-brand-preview__asset--web { right:8%; bottom:8%; width:40%; height:34%; padding:.8rem; }
  .gch-brand-preview__mini-web { height:calc(100% - 1.4rem); display:grid; grid-template-columns:1fr 1fr; grid-template-rows:auto 1fr auto; gap:.35rem; }
  .gch-brand-preview__mini-web i { grid-column:1/-1; height:.45rem; border-radius:999px; background:#d4900c; }
  .gch-brand-preview__mini-web b { min-height:3rem; background:#0b0d12; border-radius:.4rem; }
  .gch-brand-preview__mini-web span { background:#ede9e2; border-radius:.35rem; min-height:1.4rem; }
  .gch-brand-preview__annotation { align-self:end; padding:1rem; border:1px solid rgba(255,255,255,.08); border-radius:.9rem; background:rgba(11,13,18,.78); color:#f2efe8; }
  .gch-brand-preview__annotation>span { color:var(--gch-gold-dark); font:700 .55rem/1 "JetBrains Mono",monospace; letter-spacing:.08em; text-transform:uppercase; }
  .gch-brand-preview__annotation strong { display:block; margin:.6rem 0 .45rem; font:800 .86rem/1.1 "JetBrains Mono",monospace; text-transform:uppercase; }
  .gch-brand-preview__annotation p { margin:0; color:rgba(242,239,232,.7); font:500 .72rem/1.45 "Outfit",sans-serif; }
  @media(max-width:700px){.gch-brand-preview{grid-template-columns:1fr}.gch-brand-preview__annotation{display:none}.gch-brand-preview__asset--mark{left:4%;width:46%}.gch-brand-preview__asset--type{right:4%;width:44%}.gch-brand-preview__asset--color{left:5%;width:44%}.gch-brand-preview__asset--web{right:5%;width:44%}}
  @media(prefers-reduced-motion:reduce){.gch-brand-preview__asset{transition:none}.gch-brand-preview__asset:hover,.gch-brand-preview__asset:focus-visible,.gch-brand-preview__asset[aria-pressed="true"]{transform:none}}
</style>
