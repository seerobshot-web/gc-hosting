---
interface Props {
  label: string;
  description: string;
  href: string;
}

const { label, description, href } = Astro.props;
---

<a
  href={href}
  class="flex flex-col gap-2 rounded-lg border border-ink/10 bg-white p-6 transition hover:border-gold"
>
  <h3 class="font-display text-xl text-ink">{label}</h3>
  <p class="text-sm text-ink-sub">{description}</p>
</a>
