---
// `packages/motion` exports vanilla TS primitives, not a UI-framework
// component — so there's no `client:visible`-style directive to attach
// here the way there would be for a React/Vue island. Instead, this
// component's <script> tag (which Astro ships to the client automatically)
// IS the hydration boundary: everything else on the page renders as static
// HTML, and only this hero section runs any client JS. That preserves the
// scaffold prompt's intent — "don't hydrate the whole page, just the
// video/3D hero section" — without a framework in the loop.
---

<div id="hero-scene" class="relative h-[70vh] w-full overflow-hidden bg-midnight-veil">
  <div id="hero-scene-canvas" class="absolute inset-0"></div>
</div>

<script>
  import { createParallaxScene } from "@gch/motion";
  import * as THREE from "three";

  const container = document.getElementById("hero-scene-canvas");
  if (container) {
    createParallaxScene({
      container,
      onInit: ({ scene }) => {
        // Placeholder sculptural object — swap for a real GLTF/Spline
        // export once 3D assets exist. Keeps the parallax wiring testable
        // without blocking on asset production.
        const geometry = new THREE.IcosahedronGeometry(1.4, 0);
        const material = new THREE.MeshStandardMaterial({
          color: 0xa83e1b,
          flatShading: true,
        });
        const mesh = new THREE.Mesh(geometry, material);
        scene.add(mesh);

        const light = new THREE.DirectionalLight(0xe0a537, 2);
        light.position.set(2, 2, 3);
        scene.add(light);
        scene.add(new THREE.AmbientLight(0xf6f2e7, 0.4));
      },
    });
  }
</script>
