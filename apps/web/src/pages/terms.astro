---
import { siteRoutes } from "../config/site-routes";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Terms | Glory Cloud Hosts" description="Terms approval status." canonicalPath={siteRoutes.terms}>
  <main class="mx-auto max-w-3xl px-6 py-16"><h1>Terms</h1><p>Pending approval</p><p>Seed, Fruit and Harvest packages describe a 12-month prepaid term from activation. Final renewal, cancellation and refund terms require approval before checkout is available.</p><p><a href={siteRoutes.contact}>Contact us</a></p></main>
</Layout>
