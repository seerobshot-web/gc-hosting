---
import Layout from "../layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL;
const modules = [
  {
    type: "LINK",
    label: "Sunday livestream",
    description: "Feature the weekly stream at the top of the page.",
    status: "Live",
  },
  {
    type: "EVENT",
    label: "Fall revival weekend",
    description: "Promote registration and schedule details.",
    status: "Scheduled",
  },
  {
    type: "GIVING_EXTERNAL",
    label: "Online giving",
    description: "Point visitors to the secure giving platform.",
    status: "Connected",
  },
  {
    type: "ANNOUNCEMENT",
    label: "Volunteer sign-ups",
    description: "Highlight current serving opportunities.",
    status: "Draft",
  },
];
---

<Layout title="Dashboard Preview | Glory Cloud Hosts">
  <main class="min-h-screen bg-cream">
    <section class="border-b border-ink/10 bg-white/70">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-gold-text">
            GitHub Pages Preview
          </p>
          <h1 class="font-display text-3xl text-ink">
            GloryLink Dashboard
          </h1>
        </div>
        <a
          href={baseUrl}
          class="rounded-md border border-ink/10 px-4 py-2 text-sm font-medium text-ink transition hover:border-gold hover:text-gold-text"
        >
          Back to site
        </a>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-6 px-6 py-10 lg:grid-cols-[220px_minmax(0,1fr)]">
      <aside class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm">
        <p class="text-xs uppercase tracking-[0.25em] text-gold-text">
          Workspace
        </p>
        <h2 class="mt-2 font-display text-2xl text-ink">
          New Hope Church
        </h2>
        <p class="mt-2 text-sm text-ink-sub">
          Static preview for sharing layout and content hierarchy before wiring
          live auth and API data.
        </p>

        <nav class="mt-6 space-y-2 text-sm">
          <div class="rounded-lg bg-brand px-3 py-2 font-medium text-white">
            GloryLink modules
          </div>
          <div class="rounded-lg px-3 py-2 text-ink-sub">
            Branding
          </div>
          <div class="rounded-lg px-3 py-2 text-ink-sub">
            Analytics
          </div>
          <div class="rounded-lg px-3 py-2 text-ink-sub">
            Publishing
          </div>
        </nav>
      </aside>

      <div class="space-y-6">
        <div class="grid gap-4 md:grid-cols-3">
          <article class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.25em] text-gold-text">
              Active modules
            </p>
            <p class="mt-3 font-display text-4xl text-ink">4</p>
          </article>
          <article class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.25em] text-gold-text">
              Published
            </p>
            <p class="mt-3 font-display text-4xl text-ink">3</p>
          </article>
          <article class="rounded-2xl border border-ink/10 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.25em] text-gold-text">
              Last updated
            </p>
            <p class="mt-3 text-lg font-medium text-ink">Today</p>
          </article>
        </div>

        <section class="rounded-2xl border border-ink/10 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-2 border-b border-ink/10 pb-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-gold-text">
                Preview data
              </p>
              <h2 class="font-display text-2xl text-ink">
                Module lineup
              </h2>
            </div>
            <p class="text-sm text-ink-sub">
              Mirrors the intended dashboard presentation without requiring a
              live session.
            </p>
          </div>

          <ul class="mt-6 space-y-4">
            {
              modules.map((module) => (
                <li class="rounded-xl border border-ink/10 bg-white px-4 py-4">
                  <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                    <div>
                      <p class="text-xs uppercase tracking-[0.2em] text-gold-text">
                        {module.type.replace("_", " ")}
                      </p>
                      <h3 class="mt-1 text-lg font-medium text-ink">
                        {module.label}
                      </h3>
                      <p class="mt-1 text-sm text-ink-sub">
                        {module.description}
                      </p>
                    </div>
                    <span class="inline-flex rounded-full bg-gold px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-brand">
                      {module.status}
                    </span>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </section>
  </main>
</Layout>
