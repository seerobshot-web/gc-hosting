---
import { siteRoutes } from "../config/site-routes";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Refund policy | Glory Cloud Hosts" description="Refund policy approval status." canonicalPath={siteRoutes.refunds}>
  <main class="mx-auto max-w-3xl px-6 py-16"><h1>Refund policy</h1><p>Pending approval</p><p>The refund policy is awaiting approval. Contact admin@gloryhost.cloud with questions. Held orders are reviewed by the team and are not automatically refunded.</p><p><a href={siteRoutes.contact}>Contact us</a></p></main>
</Layout>
