---
import { siteRoutes } from "../config/site-routes";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Privacy | Glory Cloud Hosts" description="Privacy approval status." canonicalPath={siteRoutes.privacy}>
  <main class="mx-auto max-w-3xl px-6 py-16"><h1>Privacy</h1><p>Pending approval</p><p>Final privacy terms covering account information, payments, onboarding uploads, service providers and retention require approval before checkout is available.</p><p><a href={siteRoutes.contact}>Contact us</a></p></main>
</Layout>
