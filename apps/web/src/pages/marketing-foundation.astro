---
import Layout from "../layouts/Layout.astro";
import GCHPrimaryNav from "../components/marketing/GCHPrimaryNav.astro";
import GCHCategoryRail from "../components/marketing/GCHCategoryRail.astro";
import GCHPathwayCta from "../components/marketing/GCHPathwayCta.astro";
import GCHHudLabel from "../components/marketing/GCHHudLabel.astro";
import GCHHeroValueProposition from "../components/marketing/GCHHeroValueProposition.astro";
import GCHPrimaryConversionCta from "../components/marketing/GCHPrimaryConversionCta.astro";
import GCHGoalSelector from "../components/marketing/GCHGoalSelector.astro";
import GCHSolutionPortals from "../components/marketing/GCHSolutionPortals.astro";
import GCHLivingPatternGallery from "../components/marketing/GCHLivingPatternGallery.astro";
import GCHFinalConversion from "../components/marketing/GCHFinalConversion.astro";
---

<Layout title="GCH Public Marketing Foundation">
  <GCHPrimaryNav />

  <main>
    <GCHHeroValueProposition />

    <section class="homepage-arc" aria-label="Homepage visitor journey preview">
      <div class="homepage-arc__rail">
        <GCHCategoryRail
          items={[
            { index: "04", label: "Hero", href: "#journey-04" },
            { index: "06", label: "Convert", href: "#journey-06" },
            { index: "11", label: "Intent", href: "#goal-selector" },
            { index: "12", label: "Paths", href: "#solution-portals" },
            { index: "15", label: "Gallery", href: "#living-pattern-gallery" },
            { index: "35", label: "Close", href: "#journey-35" },
          ]}
        />
      </div>

      <div class="homepage-arc__content">
        <section id="journey-04" class="journey-note">
          <GCHHudLabel index="ARC" label="Arrive → understand GCH" />
          <p>
            The hero establishes the faith-forward, tech-confident promise before the visitor
            encounters the catalog. Replace the abstract fallback scene with final worship,
            ministry, streaming, or business-meeting media when approved assets are ready.
          </p>
        </section>

        <section id="journey-06" class="journey-block journey-block--lifted">
          <GCHPrimaryConversionCta />
        </section>

        <section class="journey-block">
          <GCHGoalSelector />
        </section>

        <section class="journey-block">
          <GCHSolutionPortals />
        </section>

        <section class="journey-block journey-block--gallery">
          <GCHLivingPatternGallery />
        </section>

        <section class="journey-block journey-block--pathway">
          <GCHPathwayCta
            eyebrow="Next path"
            title="Not sure which portal matches the work?"
            body="The broader 35-journey system can route visitors by audience, need, offering, or level of support without forcing them to understand the catalog first."
            href="/start"
            cta="Use the solution finder"
          />
        </section>
      </div>
    </section>

    <div id="journey-35">
      <GCHFinalConversion />
    </div>
  </main>
</Layout>

<style>
  .homepage-arc {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(4rem, 7vw, 7rem);
  }

  .homepage-arc__rail { align-self: stretch; }

  .homepage-arc__content {
    min-width: 0;
    display: grid;
    gap: clamp(4rem, 8vw, 8rem);
  }

  .journey-note {
    display: grid;
    gap: 0.9rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--gch-border-light);
  }

  .journey-note p {
    max-width: 64ch;
    margin: 0;
    color: var(--gch-text-secondary);
    font: 400 1rem/1.65 "Outfit", system-ui, sans-serif;
  }

  .journey-block--lifted {
    margin-top: clamp(-2rem, -3vw, -4rem);
    position: relative;
    z-index: 3;
  }

  .journey-block--gallery {
    min-width: 0;
    border-top: 1px solid var(--gch-border-light);
    border-bottom: 1px solid var(--gch-border-light);
  }

  .journey-block--pathway { padding-bottom: 1rem; }

  @media (max-width: 900px) {
    .homepage-arc { grid-template-columns: 1fr; }
    .homepage-arc__rail { order: -1; }
    .journey-block--lifted { margin-top: 0; }
  }
</style>
