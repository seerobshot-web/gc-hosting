// GCH Prisma schema
//
// NOTE ON DATABASE PROVIDER: production uses the MySQL database provisioned
// on the Hostinger account. DATABASE_URL points at that instance.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev machines; "debian-openssl-1.1.x" is what
  // Hostinger's actual Node.js hosting runtime needs (confirmed via a real
  // PrismaClientInitializationError there: client was generated for
  // debian-openssl-3.0.x but the deployment target is debian-openssl-1.1.x).
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Top-level tenant — a ministry or client organization.
model Org {
  id             String   @id @default(cuid())
  name           String
  /// URL-safe handle, reserved for per-workspace routing (`/w/[slug]`) even
  /// though v1 has no workspace switcher.
  slug           String   @unique
  /// When set, a user registering or signing in with an email at this domain
  /// is auto-added as a MEMBER. May only ever be set to a domain with a
  /// matching OrgDomainVerification.verifiedAt — the api refuses otherwise.
  autoJoinDomain String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients             Client[]
  glinks              GLink[]
  memberships         Membership[]
  subscription        Subscription?
  invoices            Invoice[]
  invitations         Invitation[]
  domainVerifications OrgDomainVerification[]
  orders              Order[]
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// An emailed invitation to join an Org. The raw token goes only into the
/// email link; the row stores its sha256, same as RefreshToken.
model Invitation {
  id              String           @id @default(cuid())
  orgId           String
  org             Org              @relation(fields: [orgId], references: [id])
  email           String
  role            Role
  invitedByUserId String
  invitedBy       User             @relation(fields: [invitedByUserId], references: [id])
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([orgId, status])
  @@index([email])
}

/// Proof of domain ownership via a DNS TXT record — the gate in front of
/// Org.autoJoinDomain. An admin gets a token to publish; verification
/// resolves the record and stamps verifiedAt only when it matches.
model OrgDomainVerification {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id])
  domain      String
  dnsTxtToken String    @unique
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orgId, domain])
  @@index([domain])
}

/// A purchasable workspace tier. Mirrors a Stripe Price by id — Stripe
/// stays the authority on what it costs; this row is what the portal lists
/// and what a Subscription points at. Seat-based: quantity on the Stripe
/// subscription item = active Memberships.
model Plan {
  id                String   @id @default(cuid())
  stripePriceId     String   @unique
  name              String
  /// Null = unlimited seats.
  seatLimit         Int?
  pricePerSeatCents Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  subscriptions Subscription[]
  orders        Order[]
}

/// One Stripe subscription per Org (workspace-level SaaS billing). This is
/// deliberately separate from FOSSBilling, which remains the system of record
/// for individual hosting-account billing — never conflate the two.
model Subscription {
  id                       String    @id @default(cuid())
  orgId                    String    @unique
  org                      Org       @relation(fields: [orgId], references: [id])
  planId                   String?
  plan                     Plan?     @relation(fields: [planId], references: [id])
  stripeCustomerId         String
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionItemId String?
  /// Stripe's status string as-is (`active`, `trialing`, `past_due`,
  /// `canceled`, `incomplete`, …). A plain string on purpose: Stripe controls
  /// this set and can add values outside this app's release cycle — unlike
  /// GLinkModuleType, which stays a closed enum deliberately.
  status                   String    @default("incomplete")
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean   @default(false)
  seatsPurchased           Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  invoices Invoice[]

  @@index([stripeCustomerId])
}

/// Read-only mirror of a Stripe invoice, keyed by Stripe's id — same
/// "reference by external id, don't duplicate authority" pattern as
/// Client.fossbillingClientId. Populated only by webhooks.
model Invoice {
  id               String        @id @default(cuid())
  stripeInvoiceId  String        @unique
  orgId            String
  org              Org           @relation(fields: [orgId], references: [id])
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  status           String
  currency         String
  amountDueCents   Int
  amountPaidCents  Int
  hostedInvoiceUrl String?
  periodStart      DateTime
  periodEnd        DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orgId, createdAt])
}

/// Idempotency ledger for Stripe webhooks: the id is Stripe's event id, so
/// a redelivered event hits the unique key and is acknowledged without
/// being processed twice.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// A portal account — the real identity behind logins, distinct from
/// `Client` (which mirrors a FOSSBilling record and may predate the person
/// ever creating a portal account).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  memberships     Membership[]
  refreshTokens   RefreshToken[]
  clients         Client[]
  sentInvitations Invitation[]
}

/// The revocable half of the auth pair — access tokens stay short-lived and
/// stateless (JWT), refresh tokens are looked up here so "sign out" and
/// "sign out everywhere" actually work.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Join table making multi-tenant workspaces real: one User, many Orgs, one
/// role per (user, org) pair.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  role      Role
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Mirrors the FOSSBilling client record via an external ID field —
/// billing data itself is never duplicated here, only referenced.
model Client {
  id                  String   @id @default(cuid())
  orgId               String
  org                 Org      @relation(fields: [orgId], references: [id])
  fossbillingClientId String   @unique
  email               String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// Links this FOSSBilling-mirrored record to the portal identity that
  /// owns it, once one exists. Nullable: a Client can predate any portal
  /// account (e.g. imported from FOSSBilling before the person ever logs
  /// into the portal). This is a portal-identity link only — it does not
  /// change what Client itself means or how GLink/ProvisioningOrder use it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  glinks             GLink[]
  provisioningOrders ProvisioningOrder[]

  @@index([orgId])
  @@index([userId])
}

/// Local shadow of a ResellPortal order. ResellPortal is request-only with
/// no webhooks, so this table is the state a background poller updates —
/// there is no event to listen for, only a status to keep checking.
model ProvisioningOrder {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id])
  cpanelUsername      String
  primaryDomain       String
  resellPortalOrderId String?
  status              String    @default("provisioning") // provisioning | deployed | failed
  nextBillingDate     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}

/// GloryLink's closed six-value module-type enum. Deliberately NOT an open
/// string field — extending it requires a real migration, which is the
/// point (every module is pre-vetted for theological/brand appropriateness).
enum GLinkModuleType {
  LINK
  GIVING_EXTERNAL
  EVENT
  SERMON_SERIES
  ANNOUNCEMENT
  SOCIAL_EMBED
}

model GLink {
  id         String          @id @default(cuid())
  orgId      String
  org        Org             @relation(fields: [orgId], references: [id])
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id])
  moduleType GLinkModuleType
  label      String
  url        String?
  position   Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([orgId])
  @@index([clientId])
}

/// Actor, action, target entity, timestamp — the table the future Agent
/// Plan (GCH Aleph) writes to for every automated action it takes.
model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  targetType String
  targetId   String
  metadata   String? // JSON-encoded string (SQLite has no native JSON type)
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actor])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// GCH-ALEPH order → provisioning domain model (Phase 3)
//
// Encodes the three core invariants from AUTHORITY-BOUNDARIES.md:
//   1. One paid GCH order line grants AT MOST one active provider service —
//      enforced at the DB level by ProviderService.orderId @unique.
//   2. External mutations are replayable via IdempotencyRecord
//      (key = sha256(entityType:entityId:operationName), see IDEMPOTENCY.md).
//   3. Every state transition is auditable (AuditLog, above).
// ---------------------------------------------------------------------------

/// Lifecycle of a GCH order line. Stripe drives PENDING → PAID; the
/// provisioning orchestrator drives PAID → PROVISIONING → ACTIVE. CANCELLED
/// and FAILED are terminal off-ramps.
enum OrderStatus {
  PENDING
  PAID
  PROVISIONING
  ACTIVE
  CANCELLED
  FAILED
}

/// A single purchase of a Plan by an Org — the GCH-ALEPH order line that the
/// state machine tracks from checkout through provisioning. Distinct from the
/// legacy `ProvisioningOrder` shadow table (a poller-updated mirror of a
/// ResellPortal order keyed off Client); this Order is the org-facing,
/// Stripe-anchored commercial record.
model Order {
  id              String      @id @default(cuid())
  orgId           String
  org             Org         @relation(fields: [orgId], references: [id])
  /// Set only once Stripe confirms payment, hence nullable; still globally
  /// unique so a Stripe PaymentIntent can back at most one order.
  stripePaymentId String?     @unique
  status          OrderStatus @default(PENDING)
  planId          String
  plan            Plan        @relation(fields: [planId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  /// Null until provisioned. One-to-one — the guard lives on
  /// ProviderService.orderId @unique.
  providerService ProviderService?

  @@index([orgId])
  @@index([status])
}

/// Fulfillment state of the ResellPortal service behind an order.
enum ProviderStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// The provisioned ResellPortal service for an order. `orderId @unique` is the
/// DB-level "one active service per order" invariant — do not remove it.
/// `resellPortalId` is the external ID returned by ResellPortal.
model ProviderService {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  resellPortalId String         @unique
  status         ProviderStatus @default(PROVISIONING)
  provisionedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

/// Replay ledger for external mutations. The key is a deterministic
/// sha256(entityType:entityId:operationName) (see IDEMPOTENCY.md), so a retry
/// of the same logical operation hits the same row and returns the stored
/// result instead of re-executing. `expiresAt` drives TTL cleanup (24h for
/// most ops, 7d for provisioning).
model IdempotencyRecord {
  key       String   @id
  result    Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
