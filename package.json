{
  "name": "gc-hosting-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "eslint": "^10.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.1",
      "postcss": "^8.5.18",
      "sharp": "^0.35.4",
      "fastify": "^5.12.5"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "prisma"
    ]
  }
}
