# Copy to .env and fill in per environment. See packages/database/.env.example
# for the database-specific variable.

# ResellPortal wholesale provisioning API credentials — required by
# apps/api's provisioning module and workers/cron-jobs' resellportal-poller.
# The real API requires BOTH headers on every call, key alone is rejected.
RESELLPORTAL_API_KEY=
RESELLPORTAL_API_SECRET=

# Required in production. Keep true for test orders; set false only when this
# deployment is intentionally allowed to place billable wholesale orders.
RESELLPORTAL_TEST_MODE=true

# Base URL apps/portal uses to reach apps/api. Defaults to
# http://localhost:3333 if unset (see apps/portal/src/lib/api-client.ts).
GCH_API_URL=http://localhost:3333

# apps/portal's own origin, allow-listed by apps/api's CORS config. Defaults
# to http://localhost:3001 if unset (see apps/api/src/main.ts).
GCH_PORTAL_ORIGIN=http://localhost:3001

# Secret apps/api uses to sign and verify access-token JWTs. Required — the
# app throws on boot if unset (see apps/api/src/auth/jwt.strategy.ts).
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Shared secret NextAuth (apps/portal) uses to sign its own session cookie.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# apps/portal's own public URL, required by NextAuth.
NEXTAUTH_URL=http://localhost:3001

# Required in production (`next start`) or NextAuth rejects every request
# with "UntrustedHost" — Hostinger's Node.js hosting runs the built app the
# same way, so this must be set there too, not just locally.
AUTH_TRUST_HOST=true
