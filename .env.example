# Copy to .env and fill in per environment. See packages/database/.env.example
# for the database-specific variable.

# ResellPortal wholesale provisioning API credentials — required by
# apps/api's provisioning module and workers/cron-jobs' resellportal-poller.
# The real API requires BOTH headers on every call, key alone is rejected.
RESELLPORTAL_API_KEY=
RESELLPORTAL_API_SECRET=

# Required in production. Keep true for test orders; set false only when this
# deployment is intentionally allowed to place billable wholesale orders.
RESELLPORTAL_TEST_MODE=

# Stripe — workspace (Org-level, seat-based) subscription billing. Separate
# from FOSSBilling, which stays the system of record for hosting accounts.
# Both are required by apps/api's billing module; non-billing routes still
# boot without them. STRIPE_WEBHOOK_SECRET is the signing secret of the
# endpoint pointed at <api origin>/webhooks/stripe (or from `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (invitations, billing notices) via the account's own
# Hostinger Business Email mailbox over SMTP — no third-party ESP. SMTP_USER
# and SMTP_PASS are a Hostinger mailbox address and its password (e.g.
# info@gloryhost.cloud). Leave SMTP_USER empty to log emails instead of
# sending — that's what dev/test runs do.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Base URL apps/portal uses to reach apps/api. Defaults to
# http://localhost:3333 if unset (see apps/portal/src/lib/api-client.ts).
GCH_API_URL=

# Required shared key for /dashboard/overview access. apps/api rejects the
# route if this is unset or if apps/portal sends the wrong value.
DASHBOARD_API_KEY=

# Canonical portal URL for absolute SEO/JSON-LD links. Usually matches
# GCH_PORTAL_ORIGIN / NEXTAUTH_URL.
NEXT_PUBLIC_SITE_URL=

# apps/portal's own origin, allow-listed by apps/api's CORS config. Defaults
# to http://localhost:3001 if unset (see apps/api/src/main.ts).
GCH_PORTAL_ORIGIN=

# Secret apps/api uses to sign and verify access-token JWTs. Required — the
# app throws on boot if unset (see apps/api/src/auth/jwt.strategy.ts).
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Shared secret NextAuth (apps/portal) uses to sign its own session cookie.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# apps/portal's own public URL, required by NextAuth.
NEXTAUTH_URL=

# Required in production (`next start`) or NextAuth rejects every request
# with "UntrustedHost" — Hostinger's Node.js hosting runs the built app the
# same way, so this must be set there too, not just locally.
AUTH_TRUST_HOST=

# ---------------------------------------------------------------------------
# Phase 2 — Security hardening (validated on boot by apps/api's env.schema.ts;
# the API refuses to start if any required var below is missing/malformed).
# ---------------------------------------------------------------------------

# MySQL connection string for Prisma (packages/database). Required.
# e.g. mysql://user:password@localhost:3306/gch
DATABASE_URL=

# Stripe webhook signing secret for the endpoint at <api origin>/webhooks/stripe
# (or from `stripe listen`). Required — the webhook rejects any request whose
# signature can't be verified against this value.

# ResellPortal API secret — the panel API requires BOTH X-API-Key and
# X-API-Secret on every call. Required.

# Base URL of the ResellPortal provisioning API. Required.
# Default upstream: https://panel.resellportal.com/wp-json/resellportal/v1
RESELLPORTAL_BASE_URL=

# GLINKS internal API — the legacy VPS is reached only via an HMAC-signed
# internal REST API (see docs/architecture/GLINKS-INTEGRATION.md). Required.
# GLINKS_INTERNAL_SECRET signs every outbound request (X-Internal-Token).
GLINKS_INTERNAL_SECRET=
GLINKS_BASE_URL=

# CORS allowlist for apps/api — comma-separated exact origins. Required.
# Never use "*" or origin:true; every browser origin must be listed here.
# e.g. https://portal.gloryhost.cloud,https://admin.gloryhost.cloud
ALLOWED_ORIGINS=

# Prepaid commerce: test-only; every flag defaults to disabled.
# Global kill switch; only literal true enables the test-only prepaid path.
COMMERCE_ENABLED=
# Comma-separated verified deal IDs. RP deals stay disabled regardless.
COMMERCE_ENABLED_DEALS=
# Only set true after sales tax, Terms, Privacy, refunds and receipts are approved.
COMMERCE_POLICIES_APPROVED=
# Dedicated test webhook at /commerce/webhook; separate from subscription webhooks.
COMMERCE_STRIPE_WEBHOOK_SECRET=
# Test ops mailbox; receives held/manual-fulfillment notices.
COMMERCE_OPS_EMAIL=
# Explicit JWT user-ID allowlist for ops; tenant OWNER alone does not grant cross-customer access.
COMMERCE_OPS_USER_IDS=
# Independent random secret, at least 32 characters; signs one-hour guide links.
COMMERCE_DELIVERY_SECRET=
# Absolute private folder holding the ten original PDFs; never app/public.
COMMERCE_GUIDE_DIRECTORY=
# Explicit API origin used for signed guide links.
COMMERCE_API_ORIGIN=
# Explicit portal origin for Stripe success/cancel redirects.
COMMERCE_PORTAL_ORIGIN=
# Only literal true offers ACH; unpaid completion never provisions.
COMMERCE_ACH_ENABLED=
# Public marketing portal link; no secrets.
PUBLIC_COMMERCE_PORTAL_ORIGIN=

# 64 hex characters (32 random bytes); encrypts brand intake with AES-256-GCM.
COMMERCE_INTAKE_KEY=

# Explicit tax decision; only none is supported by this test rollout. Unset/other values block checkout.
COMMERCE_TAX_MODE=
